{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "swarm.handover v1",
  "description": "Versioned handover document between agents (DESIGN 4.7). Strict: unknown fields need a new schema_version. The 16384-byte cap and deterministic summarization live in swarm/handover.py.",
  "type": "object",
  "required": [
    "schema_version",
    "handover_id",
    "correlation_id",
    "task_id",
    "from_agent",
    "to_agent",
    "created_wall",
    "goal",
    "completed",
    "remaining",
    "decisions",
    "artifacts",
    "open_questions",
    "blockers",
    "constraints",
    "verification",
    "summarized",
    "bytes"
  ],
  "properties": {
    "schema_version": {
      "const": "swarm.handover.v1"
    },
    "handover_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "from_agent": {
      "type": "string",
      "minLength": 1
    },
    "to_agent": {
      "type": "string",
      "minLength": 1
    },
    "created_wall": {
      "type": "number"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision",
          "rationale"
        ],
        "properties": {
          "decision": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "uri",
          "digest",
          "producer"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "confidence",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partial",
            "unverified"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "summarized": {
      "type": "boolean"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
