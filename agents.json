{
  "schema": "swarm.manifest.v1",
  "version": "1.0.0",
  "defaults": { "model": "sonnet", "heartbeat_s": 10, "offer_timeout_s": 60 },
  "agents": [
    { "id": "A01", "code": "ORCH", "slug": "a01-orchestrator", "name": "Swarm Orchestrator", "class": "control", "lane": "control", "model": "opus", "spec": "03-agents/A01-orchestrator.md", "prompt": "prompts/A01-orchestrator.md",
      "description": "Swarm control plane. Use to decompose a brief into a task DAG, schedule/assign tasks to the other 14 agents, enforce gates and budgets, arbitrate conflicts and escalate to humans. Owns the plan, never writes code/docs/IaC.",
      "capabilities": ["plan.decompose", "plan.schedule", "plan.arbitrate", "plan.escalate"],
      "consumes": ["project.brief", "task.bid", "task.status", "task.result", "gate.verdict", "agent.heartbeat", "conflict.report"],
      "produces": ["task.offer", "task.assign", "plan.updated", "conflict.arbitration", "escalation.request", "swarm.status"],
      "max_parallel": 8, "autonomy_ceiling": { "schedule": "L2", "budget": "L3", "kill_release": "L3", "accept_risk": "L4" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Agent", "Write"],
      "scripts": ["scripts/orch_plan.py", "scripts/orch_status.py", "scripts/swarm_run.py"] },

    { "id": "A02", "code": "REQ", "slug": "a02-requirements", "name": "Requirements Engineer", "class": "delivery", "lane": "delivery", "spec": "03-agents/A02-requirements.md", "prompt": "prompts/A02-requirements.md",
      "description": "Turns briefs into a requirements spec, user stories and machine-checkable acceptance criteria (Given/When/Then). Use at the start of any feature or when criteria are ambiguous/untestable.",
      "capabilities": ["req.elicit", "req.spec", "req.acceptance"],
      "consumes": ["project.brief", "incident.alert", "test.results"],
      "produces": ["requirements.spec", "acceptance.criteria", "user.story"],
      "max_parallel": 4, "autonomy_ceiling": { "spec": "L2", "scope_change": "L3" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/req_lint.py"] },

    { "id": "A03", "code": "ARCH", "slug": "a03-architect", "name": "Solution Architect", "class": "delivery", "lane": "delivery", "model": "opus", "spec": "03-agents/A03-architect.md", "prompt": "prompts/A03-architect.md",
      "description": "Produces the C4 blueprint, API contracts (OpenAPI/AsyncAPI), ADRs and tech-stack decisions from requirements. Use for design tasks, contract changes and architecture fitness checks.",
      "capabilities": ["design.blueprint", "design.contract", "design.adr", "design.fitness"],
      "consumes": ["requirements.spec", "acceptance.criteria", "incident.alert", "patch.task"],
      "produces": ["architecture.blueprint", "api.contract", "adr.set", "tech.stack"],
      "max_parallel": 3, "autonomy_ceiling": { "adr": "L2", "breaking_contract": "L3" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/arch_adr.py", "scripts/arch_contract_check.py"] },

    { "id": "A04", "code": "UXD", "slug": "a04-ux-designer", "name": "UX Designer", "class": "delivery", "lane": "delivery", "spec": "03-agents/A04-ux-designer.md", "prompt": "prompts/A04-ux-designer.md",
      "description": "Owns design tokens, wireframes, UX specs and accessibility (WCAG) requirements. Use for any UI-facing feature before frontend implementation.",
      "capabilities": ["ux.tokens", "ux.spec", "ux.a11y"],
      "consumes": ["requirements.spec", "acceptance.criteria", "architecture.blueprint"],
      "produces": ["design.system.tokens", "ux.spec", "a11y.requirements"],
      "max_parallel": 3, "autonomy_ceiling": { "spec": "L2", "brand_change": "L3" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/ux_tokens.py"] },

    { "id": "A05", "code": "BE", "slug": "a05-backend", "name": "Backend Engineer", "class": "build", "lane": "code", "spec": "03-agents/A05-backend.md", "prompt": "prompts/A05-backend.md",
      "description": "Implements backend services against A03 contracts and A07 data contracts, with unit tests. Use for server-side code, APIs, business logic and hotfix patches.",
      "capabilities": ["code.backend", "code.api", "code.patch"],
      "consumes": ["api.contract", "data.contract", "schema.migration", "acceptance.criteria", "review.verdict", "gate.verdict"],
      "produces": ["code.patch", "unit.tests", "task.result"],
      "max_parallel": 6, "autonomy_ceiling": { "code": "L2", "contract_deviation": "L3" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/code_checks.py", "scripts/be_contract_conformance.py"] },

    { "id": "A06", "code": "FE", "slug": "a06-frontend", "name": "Frontend Engineer", "class": "build", "lane": "code", "spec": "03-agents/A06-frontend.md", "prompt": "prompts/A06-frontend.md",
      "description": "Implements UI against A04 tokens/UX specs and A03 API contracts, with component tests and a11y checks. Use for client-side code.",
      "capabilities": ["code.frontend", "code.ui", "code.patch"],
      "consumes": ["api.contract", "design.system.tokens", "ux.spec", "acceptance.criteria", "review.verdict", "gate.verdict"],
      "produces": ["code.patch", "component.tests", "task.result"],
      "max_parallel": 6, "autonomy_ceiling": { "code": "L2", "design_deviation": "L3" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/code_checks.py", "scripts/fe_a11y_check.py"] },

    { "id": "A07", "code": "DATA", "slug": "a07-data", "name": "Data Engineer", "class": "build", "lane": "code", "spec": "03-agents/A07-data.md", "prompt": "prompts/A07-data.md",
      "description": "Owns data models, schema migrations (expand/contract, reversible) and data contracts. Use for any persistence, migration or pipeline change.",
      "capabilities": ["data.model", "data.migration", "data.contract", "data.pipeline"],
      "consumes": ["architecture.blueprint", "api.contract", "acceptance.criteria", "review.verdict"],
      "produces": ["schema.migration", "data.contract", "data.model"],
      "max_parallel": 3, "autonomy_ceiling": { "migration": "L2", "destructive_ddl": "L4" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/data_migration_check.py"] },

    { "id": "A08", "code": "QA", "slug": "a08-qa", "name": "Test Engineer", "class": "verify", "lane": "verify", "spec": "03-agents/A08-qa.md", "prompt": "prompts/A08-qa.md",
      "description": "Quality gate. Translates acceptance criteria into test suites, runs them, files defects and issues the signed quality gate verdict. Never modifies product code.",
      "capabilities": ["test.plan", "test.unit", "test.integration", "test.e2e", "test.perf", "gate.quality"],
      "consumes": ["acceptance.criteria", "code.patch", "build.artifact", "ux.spec", "schema.migration"],
      "produces": ["test.plan", "test.suite", "test.results", "defect.report", "gate.verdict"],
      "max_parallel": 8, "autonomy_ceiling": { "run_suites": "L2", "block_merge": "L2", "waive": "L3" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/qa_gate.py"] },

    { "id": "A09", "code": "REV", "slug": "a09-reviewer", "name": "Code Reviewer", "class": "verify", "lane": "verify", "model": "opus", "spec": "03-agents/A09-reviewer.md", "prompt": "prompts/A09-reviewer.md",
      "description": "Review gate. Reviews diffs for correctness, standards and contract adherence and issues the signed review verdict with structured findings. Read-only on product code.",
      "capabilities": ["review.code", "review.standards", "gate.review"],
      "consumes": ["code.patch", "api.contract", "acceptance.criteria", "schema.migration"],
      "produces": ["review.verdict", "gate.verdict", "review.comments"],
      "max_parallel": 8, "autonomy_ceiling": { "verdict": "L2", "waive": "L3" },
      "tools": ["Read", "Grep", "Glob", "Bash"],
      "scripts": ["scripts/rev_gate.py"] },

    { "id": "A10", "code": "SEC", "slug": "a10-security", "name": "Security Auditor", "class": "verify", "lane": "verify", "model": "opus", "spec": "03-agents/A10-security.md", "prompt": "prompts/A10-security.md",
      "description": "Security gate. Runs SAST/secrets/dependency/IaC checks, threat-models changes, and issues the signed security gate verdict. Fail-closed; can never accept risk itself.",
      "capabilities": ["sec.sast", "sec.secrets", "sec.deps", "sec.threatmodel", "gate.security"],
      "consumes": ["code.patch", "schema.migration", "build.artifact", "iac.change", "architecture.blueprint"],
      "produces": ["security.gate.verdict", "gate.verdict", "vulnerability.report", "sbom.attestation"],
      "max_parallel": 6, "autonomy_ceiling": { "verdict": "L2", "block_release": "L2", "accept_risk": "L4" },
      "tools": ["Read", "Grep", "Glob", "Bash"],
      "scripts": ["scripts/sec_gate.py"] },

    { "id": "A11", "code": "DEVOPS", "slug": "a11-devops", "name": "DevOps / Platform Engineer", "class": "operate", "lane": "ops", "spec": "03-agents/A11-devops.md", "prompt": "prompts/A11-devops.md",
      "description": "Owns IaC, CI pipelines, build artifacts and environments. Use to provision environments, build/sign artifacts and validate pipeline configuration.",
      "capabilities": ["deploy.env", "ci.pipeline", "build.artifact", "iac.change"],
      "consumes": ["architecture.blueprint", "code.patch", "security.gate.verdict", "promote.command"],
      "produces": ["build.artifact", "iac.change", "environment.record", "ci.pipeline"],
      "max_parallel": 4, "autonomy_ceiling": { "non_prod": "L2", "prod_infra": "L3" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/devops_ci_check.py", "scripts/devops_build_record.py"] },

    { "id": "A12", "code": "REL", "slug": "a12-release", "name": "Release Manager", "class": "operate", "lane": "ops", "spec": "03-agents/A12-release.md", "prompt": "prompts/A12-release.md",
      "description": "Owns release plans, progressive delivery (canary) and rollback. Use once all gates are green to plan/promote a release, or to freeze/rollback on incident.",
      "capabilities": ["release.plan", "release.promote", "release.rollback", "gate.release"],
      "consumes": ["gate.verdict", "build.artifact", "deploy.telemetry", "incident.alert", "acceptance.criteria"],
      "produces": ["release.plan", "release.record", "promote.command", "rollback.command", "gate.verdict"],
      "max_parallel": 2, "autonomy_ceiling": { "canary": "L2", "rollback": "L2", "prod_high_risk": "L4" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write"],
      "scripts": ["scripts/rel_plan.py"] },

    { "id": "A13", "code": "OBS", "slug": "a13-observability", "name": "Observability / SRE", "class": "operate", "lane": "ops", "spec": "03-agents/A13-observability.md", "prompt": "prompts/A13-observability.md",
      "description": "Owns SLOs, dashboards, alerting and incident declaration. Use to define SLOs for a service, compute error-budget burn, or declare/triage incidents.",
      "capabilities": ["obs.slo", "obs.alerts", "obs.incident", "obs.telemetry"],
      "consumes": ["architecture.blueprint", "release.record", "build.artifact", "docs.bundle"],
      "produces": ["slo.manifest", "incident.alert", "deploy.telemetry", "monitoring.degraded"],
      "max_parallel": 4, "autonomy_ceiling": { "alerting": "L2", "incident_declare": "L2", "page_humans": "L2" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/obs_slo.py"] },

    { "id": "A14", "code": "MAINT", "slug": "a14-maintenance", "name": "Maintenance Engineer", "class": "sustain", "lane": "sustain", "spec": "03-agents/A14-maintenance.md", "prompt": "prompts/A14-maintenance.md",
      "description": "Owns patch tasks, dependency bumps, tech-debt register and EOL tracking. Use for hotfix root-cause analysis, CVE-driven patching and debt triage.",
      "capabilities": ["maint.patch", "maint.deps", "maint.debt", "maint.rca"],
      "consumes": ["incident.alert", "vulnerability.report", "release.record", "test.results"],
      "produces": ["patch.task", "debt.register", "rca.report", "dependency.bump"],
      "max_parallel": 4, "autonomy_ceiling": { "patch_task": "L2", "major_bump": "L3" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/maint_deps.py"] },

    { "id": "A15", "code": "DOC", "slug": "a15-docs", "name": "Documentation Engineer", "class": "sustain", "lane": "sustain", "model": "haiku", "spec": "03-agents/A15-docs.md", "prompt": "prompts/A15-docs.md",
      "description": "Owns docs bundles, API references, runbooks and changelogs. Use after design/implementation/release to document artifacts and validate doc links/coverage.",
      "capabilities": ["docs.bundle", "docs.api", "docs.runbook", "docs.changelog"],
      "consumes": ["requirements.spec", "architecture.blueprint", "api.contract", "code.patch", "release.record", "slo.manifest"],
      "produces": ["docs.bundle", "api.reference", "runbook", "changelog"],
      "max_parallel": 4, "autonomy_ceiling": { "docs": "L2", "public_docs": "L3" },
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "scripts": ["scripts/docs_bundle.py"] }
  ]
}
