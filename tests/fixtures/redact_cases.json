{
  "_doc": "Shared vectors for swarm/redact.py redact_text (tests/test_redact.py) and omp/src/swarm_bar.ts redactText (omp/test/swarm_bar.test.ts). A string or list of strings (joined with '') is used for input, must_not_contain and must_contain, so no secret-shaped literal sits in the repo. Output must contain no must_not_contain substring and every must_contain substring. When `expected` is present the whole output must equal it exactly (every vector is also a fixed point: redacting the output changes nothing).",
  "cases": [
    {"name": "ghp token", "input": ["ran ", "ghp_", "a1B2c3D4a1B2c3D4a1B2c3D4a1B2", " ok"], "must_not_contain": [["ghp_", "a1B2c3D4"]], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "github_pat token", "input": ["ran ", "github_pat_", "11ABCDEFG011ABCDEFG011ABCDEFG0", " ok"], "must_not_contain": ["11ABCDEFG0"], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "sk token", "input": ["ran ", "sk-", "Zx9Qw8Er7Ty6Ui5O", " ok"], "must_not_contain": ["Zx9Qw8Er7Ty6Ui5O"], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "aws key id", "input": ["ran ", "AKIA", "ABCDEFGHIJ012345", " ok"], "must_not_contain": ["ABCDEFGHIJ012345"], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "slack token", "input": ["ran ", "xoxb-", "1234567890-abcdefghij", " ok"], "must_not_contain": ["1234567890-abcdefghij"], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "jwt", "input": ["ran ", "eyJhbGciOiJIUzI1NiJ9", ".", "eyJzdWIiOiIxMjM0NTY3ODkwIn0", ".", "dBjftJeZ4CVPmB92K27uhbUJU1p1r", " ok"], "must_not_contain": ["eyJzdWIiOiIx"], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "bearer header keeps the scheme", "input": "Authorization: Bearer abcdefghij0123456789xyz", "must_not_contain": ["abcdefghij0123456789xyz"], "must_contain": ["Bearer [REDACTED]"]},
    {"name": "bearer with extra spaces", "input": "curl -H 'Authorization: Bearer   abcdefghij0123456789xyz' https://x.test", "must_not_contain": ["abcdefghij0123456789xyz"], "must_contain": ["[REDACTED]"]},
    {"name": "basic authorization header", "input": "curl -H 'Authorization: Basic dXNlcjpodW50ZXIyaHVudGVyMg==' https://x.test", "must_not_contain": ["dXNlcjpodW50ZXIy"], "must_contain": ["Authorization: Basic [REDACTED]"]},
    {"name": "proxy basic authorization header", "input": "Proxy-Authorization: Basic dXNlcjpodW50ZXIyaHVudGVyMg==", "must_not_contain": ["dXNlcjpodW50ZXIy"], "must_contain": ["Proxy-Authorization: Basic [REDACTED]"]},
    {"name": "basic header in quotes lower case", "input": "headers = {'authorization': 'basic dXNlcjpodW50ZXIyaHVudGVyMg=='}", "must_not_contain": ["dXNlcjpodW50ZXIy"], "must_contain": ["[REDACTED]"]},
    {"name": "pem block", "input": "key:\n-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA\nabc/def+ghi=\n-----END RSA PRIVATE KEY-----\ntail", "must_not_contain": ["MIIEowIBAAKCAQEA", "abc/def+ghi="], "must_contain": ["key:\n[REDACTED]\ntail"]},
    {"name": "truncated pem block", "input": "x -----BEGIN PRIVATE KEY-----\nMIIBVgIBADANBgkqhkiG9w0B", "must_not_contain": ["MIIBVgIBADANBgkqhkiG9w0B"], "must_contain": ["x [REDACTED]"]},
    {"name": "url userinfo", "input": "clone https://bob:pw123@example.com/repo.git now", "must_not_contain": ["pw123", "bob:"], "must_contain": ["https://[REDACTED]@example.com/repo.git now"]},
    {"name": "url userinfo with at sign in the password", "input": "psql postgres://u:p@ss-w0rd@db.internal/app", "must_not_contain": ["p@ss-w0rd", "ss-w0rd"], "must_contain": ["postgres://[REDACTED]@db.internal/app"]},
    {"name": "env assignment", "input": "API_KEY=hunter2hunter2 and PATH=/usr/bin", "must_not_contain": ["hunter2hunter2"], "must_contain": ["API_KEY=[REDACTED] and PATH=/usr/bin"]},
    {"name": "env assignment with quoted value", "input": "export DB_PASSWORD=\"two words here\" && run", "must_not_contain": ["two words here"], "must_contain": ["DB_PASSWORD=[REDACTED]"]},
    {"name": "single-quoted env assignment", "input": "GITHUB_TOKEN='abc123' x=1", "must_not_contain": ["abc123"], "must_contain": ["GITHUB_TOKEN=[REDACTED] x=1"]},
    {"name": "query string token", "input": "https://x.test/cb?token=abc123&page=2", "must_not_contain": ["abc123"], "must_contain": ["token=[REDACTED]&page=2"]},
    {"name": "flag with equals", "input": "run --password=s3cr3t --verbose", "must_not_contain": ["s3cr3t"], "must_contain": ["--password=[REDACTED] --verbose"]},
    {"name": "space-separated password flag", "input": "login --password hunter2", "must_not_contain": ["hunter2"], "must_contain": ["login --password [REDACTED]"]},
    {"name": "space-separated password flag mid-command", "input": "mysql --user root --password hunter2 --host db.internal", "must_not_contain": ["hunter2"], "must_contain": ["--user root", "--password [REDACTED] --host db.internal"]},
    {"name": "space-separated api-key flag", "input": "deploy --api-key sekrit123 --env prod", "must_not_contain": ["sekrit123"], "must_contain": ["--api-key [REDACTED] --env prod"]},
    {"name": "space-separated token flag with quoted value", "input": "gh --token \"tok with space\" run", "must_not_contain": ["tok with space"], "must_contain": ["--token [REDACTED]"]},
    {"name": "single-dash compound flag", "input": "tool -db-password hunter2 go", "must_not_contain": ["hunter2"], "must_contain": ["-db-password [REDACTED] go"]},
    {"name": "flag followed by another flag keeps both", "input": "run --password --verbose please", "must_not_contain": [], "must_contain": ["run --password --verbose please"]},
    {"name": "json pair", "input": "{\"api_key\": \"abc123\", \"name\": \"bob\", \"author\": \"ann\", \"tokens\": 12}", "must_not_contain": ["abc123"], "must_contain": ["\"api_key\": \"[REDACTED]\", \"name\": \"bob\", \"author\": \"ann\", \"tokens\": 12"]},
    {"name": "single-quoted python repr pair", "input": "{'password': 'hunter2', 'user': 'bob'}", "must_not_contain": ["hunter2"], "must_contain": ["'password': '[REDACTED]'", "'user': 'bob'"]},
    {"name": "mixed quote pair", "input": "{\"secret\": 'hunter2'}", "must_not_contain": ["hunter2"], "must_contain": ["[REDACTED]"]},
    {"name": "re-serialised json pair", "input": "{\\\"password\\\": \\\"hunter2\\\", \\\"k\\\": 1}", "must_not_contain": ["hunter2"], "must_contain": ["[REDACTED]"]},
    {"name": "task id untouched", "input": "run T7f3a-be.a2 finished", "must_not_contain": [], "must_contain": ["run T7f3a-be.a2 finished"]},
    {"name": "digest untouched", "input": ["artifact digest sha256:", "ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12", " ok"], "must_not_contain": [], "must_contain": ["artifact digest sha256:ab12", " ok"]},
    {"name": "prose about keys untouched", "input": "Plain prose: we rotated the keys, tokens and passwords last week.", "must_not_contain": [], "must_contain": ["Plain prose: we rotated the keys, tokens and passwords last week."]},
    {"name": "author untouched", "input": "Use the author field; author=bob authority is delegated", "must_not_contain": [], "must_contain": ["Use the author field; author=bob authority is delegated"]},
    {"name": "bare key and counts untouched", "input": "sort_key=z cache_key=k1 tokens=1200 max_tokens=64", "must_not_contain": [], "must_contain": ["sort_key=z cache_key=k1 tokens=1200 max_tokens=64"]},
    {"name": "short lookalikes untouched", "input": "sk-short ghp_short Bearer shortone the bearer of this message", "must_not_contain": [], "must_contain": ["sk-short ghp_short Bearer shortone the bearer of this message"]},
    {"name": "basic in prose untouched", "input": "a basic authorization scheme is described in the docs", "must_not_contain": [], "must_contain": ["a basic authorization scheme is described in the docs"]},
    {"name": "mail address and path untouched", "input": "mailto:bob@example.com https://example.com/a:b@c", "must_not_contain": [], "must_contain": ["mailto:bob@example.com https://example.com/a:b@c"]},
    {"name": "plain flags untouched", "input": "git commit --message fix --author bob", "must_not_contain": [], "must_contain": ["git commit --message fix --author bob"]},
    {"name": "swarm ed25519 signer seed assignment", "input": "export SWARM_ED25519_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef && run", "must_not_contain": ["0123456789abcdef"], "must_contain": ["SWARM_ED25519_KEY=[REDACTED]"]},
    {"name": "swarm ed25519 seed in a quoted assignment", "input": "SWARM_ED25519_KEY=\"0123456789abcdef 0123456789abcdef\" run", "must_not_contain": ["0123456789abcdef"], "must_contain": ["SWARM_ED25519_KEY=[REDACTED]"]},
    {"name": "swarm signing key assignment", "input": "SWARM_SIGNING_KEY=fixture-hmac-material go", "must_not_contain": ["fixture-hmac-material"], "must_contain": ["SWARM_SIGNING_KEY=[REDACTED] go"]},
    {"name": "ed25519 seed variant", "input": "SWARM_ED25519_SEED=0123456789abcdef0123 go", "must_not_contain": ["0123456789abcdef"], "must_contain": ["SWARM_ED25519_SEED=[REDACTED] go"]},
    {"name": "ed25519 key with spaces around equals", "input": "SWARM_ED25519_KEY = 0123456789abcdef0123 go", "must_not_contain": ["0123456789abcdef"], "must_contain": ["[REDACTED] go"]},
    {"name": "ed25519 key json pair", "input": "{\"SWARM_ED25519_KEY\": \"0123456789abcdef0123\", \"n\": 1}", "must_not_contain": ["0123456789abcdef"], "must_contain": ["\"SWARM_ED25519_KEY\": \"[REDACTED]\""]},
    {"name": "ed25519 key re-serialised json pair", "input": "{\\\"SWARM_SIGNING_KEY\\\": \\\"0123456789abcdef0123\\\"}", "must_not_contain": ["0123456789abcdef"], "must_contain": ["[REDACTED]"]},
    {"name": "camelCase ed25519 key", "input": "swarmEd25519Key=0123456789abcdef0123 ed25519Key: 0123456789abcdef9999", "must_not_contain": ["0123456789abcdef"], "must_contain": ["swarmEd25519Key=[REDACTED]"]},
    {"name": "ed25519 key flag", "input": "signer --ed25519-key 0123456789abcdef0123 --signing-seed 0123456789abcdef9999 go", "must_not_contain": ["0123456789abcdef"], "must_contain": ["--ed25519-key [REDACTED]", "--signing-seed [REDACTED] go"]},
    {"name": "signing key header", "input": "curl -H 'X-Signing-Key: 0123456789abcdef0123' -H 'X-Auth-Token: abc123def456' https://x.test", "must_not_contain": ["0123456789abcdef", "abc123def456"], "must_contain": ["X-Signing-Key: [REDACTED]", "X-Auth-Token: [REDACTED]"]},
    {"name": "substrate handoff key", "input": "SUBSTRATE_HANDOFF_KEY=hmac-material-1234 up", "must_not_contain": ["hmac-material-1234"], "must_contain": ["SUBSTRATE_HANDOFF_KEY=[REDACTED] up"]},
    {"name": "substrate operator token list", "input": "SUBSTRATE_OPERATOR_TOKENS=tok-one,tok-two SUBSTRATE_TOKEN_SWARM_A05_BE=tok-three up", "must_not_contain": ["tok-one", "tok-two", "tok-three"], "must_contain": ["SUBSTRATE_OPERATOR_TOKENS=[REDACTED]", "SUBSTRATE_TOKEN_SWARM_A05_BE=[REDACTED] up"]},
    {"name": "hmac and jwt keys", "input": "hmac_key=aaaa1111bbbb jwtKey=cccc2222dddd bearer=eeee3333ffff", "must_not_contain": ["aaaa1111bbbb", "cccc2222dddd", "eeee3333ffff"], "must_contain": ["hmac_key=[REDACTED]", "jwtKey=[REDACTED]", "bearer=[REDACTED]"]},
    {"name": "key file and path names stay visible", "input": "SWARM_ED25519_KEY_FILE=/home/u/.config/agent-swarm/signing-key.hex SWARM_ED25519_KEY_PATH=/run/k GITHUB_TOKEN_FILE=/run/gh run --password-file /run/secrets/pw --token-path /run/t", "must_not_contain": [], "must_contain": ["SWARM_ED25519_KEY_FILE=/home/u/.config/agent-swarm/signing-key.hex", "SWARM_ED25519_KEY_PATH=/run/k", "GITHUB_TOKEN_FILE=/run/gh", "--password-file /run/secrets/pw", "--token-path /run/t"]},
    {"name": "key file json pair stays visible", "input": "{\"SWARM_ED25519_KEY_FILE\": \"/home/u/signing-key.hex\"}", "must_not_contain": [], "must_contain": ["\"SWARM_ED25519_KEY_FILE\": \"/home/u/signing-key.hex\""]},
    {"name": "benign key-like names untouched", "input": "KEYBOARD=us MONKEY=1 TURKEY=roast keyframes=3 --key-length 4096 cache_key_prefix=v1 sort_key=z", "must_not_contain": [], "must_contain": ["KEYBOARD=us MONKEY=1 TURKEY=roast keyframes=3 --key-length 4096 cache_key_prefix=v1 sort_key=z"]},
    {"name": "benign seed and algorithm names untouched", "input": "random_seed=42 --seed 7 ssh-keygen -t ed25519 -f id_ed25519 SWARM_ED25519_PUBLIC_KEY=abcd1234", "must_not_contain": [], "must_contain": ["random_seed=42 --seed 7 ssh-keygen -t ed25519 -f id_ed25519 SWARM_ED25519_PUBLIC_KEY=abcd1234"]},
    {"name": "bar and status keys untouched", "input": "SWARM_BAR_KEY=agent-swarm SWARM_STATUS_KEY=swarm session_id=s1 max_tokens=64 ux_tokens=3", "must_not_contain": [], "must_contain": ["SWARM_BAR_KEY=agent-swarm SWARM_STATUS_KEY=swarm session_id=s1 max_tokens=64 ux_tokens=3"]},
    {"name": "comma inside a secret value", "input": "password=pa,ss and {api_key=abc,def, name=bob}", "must_not_contain": ["pa,ss", "abc", "def"], "must_contain": ["password=[REDACTED] and", "name=bob"]},
    {"name": "cookie headers", "input": "curl -H 'Cookie: sid=abc123def456; theme=dark' -H 'Authorization: Token tok9876543210' https://x.test\nSet-Cookie: sid=zzz111222333; Path=/", "must_not_contain": ["abc123def456", "theme=dark", "tok9876543210", "zzz111222333"], "must_contain": ["Cookie: [REDACTED]' -H", "Authorization: [REDACTED]' https://x.test", "Set-Cookie: [REDACTED]"]},
    {"name": "benign assignment does not hide a later password (comma)", "input": "run user=alice,password=hunter2 now", "must_not_contain": ["hunter2"], "must_contain": ["user=alice,password=[REDACTED] now"]},
    {"name": "benign assignments then token (comma)", "input": "a=1,b=2,token=xyz987", "must_not_contain": ["xyz987"], "must_contain": ["a=1,b=2,token=[REDACTED]"]},
    {"name": "sensitive name masks its whole comma-bearing value", "input": "SECRET=a1,b2,c3 done", "must_not_contain": ["a1,b2", "b2,c3"], "must_contain": ["SECRET=[REDACTED] done"]},
    {"name": "url query string", "input": "GET https://h.test/p?a=1&password=x9y8z7&b=2", "must_not_contain": ["x9y8z7"], "must_contain": ["?a=1&password=[REDACTED]&b=2"]},
    {"name": "semicolon separated options", "input": "user=alice;password=hunter2;mode=fast", "must_not_contain": ["hunter2"], "must_contain": ["user=alice;password=[REDACTED];mode=fast"]},
    {"name": "space separated options", "input": "user=alice password=hunter2 mode=fast", "must_not_contain": ["hunter2"], "must_contain": ["user=alice password=[REDACTED] mode=fast"]},
    {"name": "comma then space ends the secret value at the space", "input": "user=alice, password=hunter2, mode=fast", "must_not_contain": ["hunter2"], "must_contain": ["user=alice, password=[REDACTED] mode=fast"]},
    {"name": "key=value pairs inside a JSON string", "input": "{\"cmd\": \"user=alice,password=hunter2\", \"n\": 1}", "must_not_contain": ["hunter2"], "must_contain": ["{\"cmd\": \"user=alice,password=[REDACTED]\", \"n\": 1}"]},
    {"name": "password inside a quoted benign value", "input": "user='a b password=hunter2' mode=fast", "must_not_contain": ["hunter2"], "must_contain": ["user='a b password=[REDACTED]' mode=fast"]},
    {"name": "quoted benign value then password", "input": "user=\"alice\",password=\"hunter 2\",mode=fast", "must_not_contain": ["hunter 2", "hunter"], "must_contain": ["user=\"alice\",password=[REDACTED]"]},
    {"name": "nested benign assignments then password", "input": "a=b=c,password=x1y2z3", "must_not_contain": ["x1y2z3"], "must_contain": ["a=b=c,password=[REDACTED]"]},
    {"name": "windows paths with = stay readable and a later token is masked", "input": "set PATH=C:\\bin;D:\\x\\a=b.txt token=abc123", "must_not_contain": ["abc123"], "must_contain": ["set PATH=C:\\bin;D:\\x\\a=b.txt token=[REDACTED]"]},
    {"name": "benign option lists are untouched", "input": "retries=3,timeout=30 region=eu;a=1&b=2 tokens=3,max_tokens=5", "must_not_contain": ["[REDACTED]"], "must_contain": ["retries=3,timeout=30 region=eu;a=1&b=2 tokens=3,max_tokens=5"]},
    {"name": "benign colon form then password assignment", "input": "note: user=alice,password=hunter2", "must_not_contain": ["hunter2"], "must_contain": ["note: user=alice,password=[REDACTED]"]},
    {"name": "masked comma value swallowed a second credential name (colon, space before its value)", "input": "{password: s1s1s1,access_token: t2t2t2}", "must_not_contain": ["s1s1s1", "t2t2t2"], "must_contain": ["{password: [REDACTED]"]},
    {"name": "masked comma value swallowed a second credential name (= with spaces)", "input": "password=a1b2c3,token = d4e5f6 done", "must_not_contain": ["a1b2c3", "d4e5f6"], "must_contain": ["password=[REDACTED] done"]},
    {"name": "masked comma value swallowed a name that has spaces before its separator", "input": "API_KEY=a1b2c3,client_secret = d4e5f6 done", "must_not_contain": ["a1b2c3", "d4e5f6"], "must_contain": ["API_KEY=[REDACTED] done"]},
    {"name": "masked value swallowed a second credential with a quoted value", "input": "token=a1b2c3,SECRET=\"d4 e5 f6\" done", "must_not_contain": ["a1b2c3", "d4 e5 f6", "e5"], "must_contain": ["token=[REDACTED] done"]},
    {"name": "masked value swallowed a sensitive flag", "input": "password=a1b2c3,--password d4e5f6 done", "must_not_contain": ["a1b2c3", "d4e5f6"], "must_contain": ["password=[REDACTED] done"]},
    {"name": "benign flag does not hide a later flag (semicolon)", "input": "run --mode v1;--password hunter2 now", "must_not_contain": ["hunter2"], "must_contain": ["--mode v1;--password [REDACTED] now"]},
    {"name": "benign flag does not hide a later flag (comma, ampersand)", "input": "-v v1,--api-key k9k9k9 --mode x&--password p8p8p8", "must_not_contain": ["k9k9k9", "p8p8p8"], "must_contain": ["-v v1,--api-key [REDACTED]", "--mode x&--password [REDACTED]"]},
    {"name": "sensitive flag value then semicolon then another sensitive flag", "input": "--password a1b2c3;--password \"d4 e5 f6\" end", "must_not_contain": ["a1b2c3", "d4 e5 f6", "e5"], "must_contain": ["--password [REDACTED] end"]},
    {"name": "shell command list", "input": "ls --color auto; mysql --password hunter2 db", "must_not_contain": ["hunter2"], "must_contain": ["ls --color auto; mysql --password [REDACTED] db"]},
    {"name": "flag inside a quoted value of a benign flag", "input": "--cmd \"x --password hunter2\" ok", "must_not_contain": ["hunter2"], "must_contain": ["--cmd \"x --password [REDACTED]\" ok"]},
    {"name": "a secret that starts with // after = is still masked", "input": "PASSWORD=//abc/def== next", "must_not_contain": ["//abc", "def=="], "must_contain": ["PASSWORD=[REDACTED] next"]},
    {"name": "credential-named URL schemes are not assignments", "input": "open token://not-a-pair and auth://host/x and secret: //x", "must_not_contain": ["[REDACTED]"], "must_contain": ["open token://not-a-pair and auth://host/x and secret: //x"]},
    {"name": "a closing quote of an enclosing string is not swallowed", "input": "{\"cmd\": \"x password=hunter2\", \"n\": 1}", "must_not_contain": ["hunter2"], "must_contain": ["{\"cmd\": \"x password=[REDACTED]\", \"n\": 1}"]},
    {"name": "benign names that are not credentials after a masked value", "input": "token=a1b2c3,count=3,user=bob done", "must_not_contain": ["a1b2c3"], "must_contain": ["token=[REDACTED] done"]},
    {"name": "cookie and authorization prose untouched", "input": "clear the cookies and check the authorization docs; cookie jar and authorization scheme", "must_not_contain": [], "must_contain": ["clear the cookies and check the authorization docs; cookie jar and authorization scheme"]},
    {"name": "re-serialised JSON pair keeps its structure", "input": "x={\\\"password\\\":\\\"abc\\\",\\\"user\\\":\\\"u\\\"}", "must_not_contain": ["abc"], "must_contain": [], "expected": "x={\\\"password\\\":\\\"[REDACTED]\\\",\\\"user\\\":\\\"u\\\"}"},
    {"name": "curl -u user:pass", "input": ["curl -u admin:", "Qx7vK2mP9wZr4Tb8", " https://x.test"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "curl -u [REDACTED] https://x.test"},
    {"name": "curl --user quoted", "input": ["curl --user 'admin:", "Qx7vK2mP9wZr4Tb8", "' https://x.test"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "curl --user [REDACTED] https://x.test"},
    {"name": "curl --proxy-user", "input": ["curl --proxy-user=a:", "Qx7vK2mP9wZr4Tb8", " https://x.test"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "curl --proxy-user=[REDACTED] https://x.test"},
    {"name": "docker run -u uid:gid and -u name are not credentials", "input": "docker run -u 1000:1000 -p 8080:80 img; ssh -u root host", "must_not_contain": [], "must_contain": ["docker run -u 1000:1000 -p 8080:80 img; ssh -u root host"]},
    {"name": "docker login -p", "input": ["docker login -u me -p ", "Qx7vK2mP9wZr4Tb8", " registry.test"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "docker login -u me -p [REDACTED] registry.test"},
    {"name": "docker run -p is a port", "input": "docker run -p 8080:80 -p 9090:90 nginx", "must_not_contain": [], "must_contain": ["docker run -p 8080:80 -p 9090:90 nginx"]},
    {"name": "mysql glued -p", "input": ["mysql -u root -p", "Qx7vK2mP9wZr4Tb8", " db"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "mysql -u root -p[REDACTED] db"},
    {"name": "mysql -p alone is a prompt", "input": "mysql -u root -p db; mysqldump --port 3306 db", "must_not_contain": [], "must_contain": ["mysql -u root -p db; mysqldump --port 3306 db"]},
    {"name": "sshpass -p quoted", "input": ["sshpass -p '", "Qx7vK2mP9wZr4Tb8", "' ssh host"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "sshpass -p [REDACTED] ssh host"},
    {"name": "redis-cli -a and sqlcmd -P", "input": ["redis-cli -a ", "Qx7vK2mP9wZr4Tb8", " ping; sqlcmd -S h -P ", "Qx7vK2mP9wZr4Tb8"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "redis-cli -a [REDACTED] ping; sqlcmd -S h -P [REDACTED]"},
    {"name": "redis-cli without a password flag", "input": "redis-cli -h host -p 6379 ping", "must_not_contain": [], "must_contain": ["redis-cli -h host -p 6379 ping"]},
    {"name": "openssl -passin", "input": ["openssl rsa -in k.pem -passin pass:", "Qx7vK2mP9wZr4Tb8"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "openssl rsa -in k.pem -passin pass:[REDACTED]"},
    {"name": "underscore flag names", "input": ["run --client_secret ", "Qx7vK2mP9wZr4Tb8", " --api_key ", "Qx7vK2mP9wZr4Tb8", " --client-secret ", "Qx7vK2mP9wZr4Tb8"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "run --client_secret [REDACTED] --api_key [REDACTED] --client-secret [REDACTED]"},
    {"name": "flags with = and headers", "input": ["curl --token=", "Qx7vK2mP9wZr4Tb8", " -H 'X-Api-Key: ", "Qx7vK2mP9wZr4Tb8", "' --data 'password=", "Qx7vK2mP9wZr4Tb8", "'"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "curl --token=[REDACTED] -H 'X-Api-Key: [REDACTED]' --data 'password=[REDACTED]'"},
    {"name": "aligned name = value", "input": ["db_password        = ", "Qx7vK2mP9wZr4Tb8", "\npassword:     ", "Qx7vK2mP9wZr4Tb8", "\nAPI_TOKEN=    ", "Qx7vK2mP9wZr4Tb8", "\n"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "db_password        = [REDACTED]\npassword:     [REDACTED]\nAPI_TOKEN=    [REDACTED]\n"},
    {"name": "stripe live key", "input": ["ran ", "sk_live_", "Qx7vK2mP9wZr4Tb8", "Qx7vK2mP9wZr4Tb8", " ok"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "ran [REDACTED] ok"},
    {"name": "stripe restricted key and webhook secret", "input": ["rk_live_", "Qx7vK2mP9wZr4Tb8", "Qx7vK2mP9wZr4Tb8", " ", "whsec_", "Qx7vK2mP9wZr4Tb8", "Qx7vK2mP9wZr4Tb8"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "[REDACTED] [REDACTED]"},
    {"name": "google api key", "input": ["key ", "AIza", "Qx7vK2mP9wZr4Tb8", "Qx7vK2mP9wZr4Tb8", "ab", " ok"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "key [REDACTED] ok"},
    {"name": "sendgrid key", "input": ["mail ", "SG.", "Qx7vK2mP9wZr4Tb8", ".", "Qx7vK2mP9wZr4Tb8", " ok"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "mail [REDACTED] ok"},
    {"name": "npm token", "input": ["npm ", "npm_", "Qx7vK2mP9wZr4Tb8", "Qx7vK2mP9wZr4Tb8", "abcd", " ok"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "npm [REDACTED] ok"},
    {"name": "gitlab and digitalocean tokens", "input": ["glpat-", "Qx7vK2mP9wZr4Tb8", " ", "dop_v1_", "Qx7vK2mP9wZr4Tb8", "Qx7vK2mP9wZr4Tb8"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "[REDACTED] [REDACTED]"},
    {"name": "aws temporary key id", "input": ["ran ", "ASIA", "ABCDEFGHIJ012345", " ok"], "must_not_contain": ["ABCDEFGHIJ012345"], "must_contain": [], "expected": "ran [REDACTED] ok"},
    {"name": "github refresh and oauth tokens", "input": ["ghr_", "Zq8Lm3Nv5Bx7Cd9Fg1Hj2Kp4Rs6Tw0Yu3Ab5Cd", " ", "gho_", "Zq8Lm3Nv5Bx7Cd9Fg1Hj2Kp4Rs6Tw0Yu3Ab5Cd"], "must_not_contain": ["Zq8Lm3Nv5Bx7Cd9Fg1Hj2Kp4Rs6Tw0Yu3Ab5Cd"], "must_contain": [], "expected": "[REDACTED] [REDACTED]"},
    {"name": "slack app token and hugging face token", "input": ["xapp-", "1-A0123-456789-abcdef", " ", "hf_", "aBcDeFgHiJkLmNoPqRsTuVwXyZ012345"], "must_not_contain": ["aBcDeFgHiJkLmNoPqRsT"], "must_contain": [], "expected": "[REDACTED] [REDACTED]"},
    {"name": "vendor KEY name with a credential-shaped value", "input": ["STRIPE_KEY=", "Zq8Lm3Nv5Bx7Cd9Fg1Hj2Kp4Rs6Tw0Yu3Ab5Cd", " SUPABASE_SERVICE_ROLE_KEY: '", "Zq8Lm3Nv5Bx7Cd9Fg1Hj2Kp4Rs6Tw0Yu3Ab5Cd", "'"], "must_not_contain": ["Zq8Lm3Nv5Bx7Cd9Fg1Hj2Kp4Rs6Tw0Yu3Ab5Cd"], "must_contain": [], "expected": "STRIPE_KEY=[REDACTED] SUPABASE_SERVICE_ROLE_KEY: [REDACTED]"},
    {"name": "lookup-style KEY names stay readable", "input": ["sort_key=name cache_key=", "0123456789abcdef0123456789abcdef", " STRIPE_KEY=short idempotency_key=my-request-key-2024-long-form"], "must_not_contain": [], "must_contain": ["sort_key=name cache_key=0123456789abcdef0123456789abcdef STRIPE_KEY=short idempotency_key=my-request-key-2024-long-form"]},
    {"name": "azure account key", "input": ["DefaultEndpointsProtocol=https;AccountName=a;AccountKey=", "Zq8Lm3Nv5Bx7Cd9Fg1Hj2Kp4Rs6Tw0Yu3Ab5Cd", ";EndpointSuffix=core.windows.net"], "must_not_contain": ["Zq8Lm3Nv5Bx7Cd9Fg1Hj2Kp4Rs6Tw0Yu3Ab5Cd"], "must_contain": [], "expected": "DefaultEndpointsProtocol=https;AccountName=a;AccountKey=[REDACTED];EndpointSuffix=core.windows.net"},
    {"name": "kubernetes env name/value pair", "input": ["env:\n- name: DB_PASSWORD\n  value: ", "Qx7vK2mP9wZr4Tb8", "\n- name: LOG_LEVEL\n  value: debug\n- name: API_TOKEN\n  value: \"", "Qx7vK2mP9wZr4Tb8", "\"\n"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "env:\n- name: DB_PASSWORD\n  value: [REDACTED]\n- name: LOG_LEVEL\n  value: debug\n- name: API_TOKEN\n  value: [REDACTED]\n"},
    {"name": "kubernetes env pair with CRLF and valueFrom untouched", "input": ["- name: DB_PASSWORD\r\n  value: ", "Qx7vK2mP9wZr4Tb8", "\r\n- name: TOKEN\r\n  valueFrom:\r\n    secretKeyRef:\r\n      name: s\r\n"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "- name: DB_PASSWORD\r\n  value: [REDACTED]\r\n- name: TOKEN\r\n  valueFrom:\r\n    secretKeyRef:\r\n      name: s\r\n"},
    {"name": "yaml block scalar", "input": ["password: |\n  ", "Qx7vK2mP9wZr4Tb8", "\n  more", "Qx7vK2mP9wZr4Tb8", "\nnext: x\n"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "password: [REDACTED]\nnext: x\n"},
    {"name": "yaml folded block scalar with blank line, nested", "input": ["config:\n  api_token: >-\n    ", "Qx7vK2mP9wZr4Tb8", "\n\n    more", "Qx7vK2mP9wZr4Tb8", "\n  other: y\n"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "config:\n  api_token: [REDACTED]\n  other: y\n"},
    {"name": "yaml block scalar of a benign key is kept", "input": "note: |\n  keep me\n  and me\nnext: x\n", "must_not_contain": [], "must_contain": ["note: |\n  keep me\n  and me\nnext: x\n"]},
    {"name": "credential after CJK text in a URL", "input": ["接続postgres://app:", "Qx7vK2mP9wZr4Tb8", "@db/x"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "接続postgres://[REDACTED]@db/x"},
    {"name": "trailing newline and CRLF", "input": ["password=", "Qx7vK2mP9wZr4Tb8", "\r\nnext=1\r\ntoken: ", "Qx7vK2mP9wZr4Tb8", "\n"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "password=[REDACTED]\r\nnext=1\r\ntoken: [REDACTED]\n"},
    {"name": "already masked values are idempotent", "input": "const cfg = { password: [REDACTED], user: 'x' }", "must_not_contain": [], "must_contain": ["const cfg = { password: [REDACTED], user: 'x' }"]},
    {"name": "quoted value then comma is masked once", "input": ["const cfg = { password: \"", "Qx7vK2mP9wZr4Tb8", "\", user: 'x' }"], "must_not_contain": ["Qx7vK2mP9wZr4Tb8"], "must_contain": [], "expected": "const cfg = { password: [REDACTED], user: 'x' }"},
    {"name": "token-shaped prefix inside a sensitive value keeps the whole value (bare prefix)", "input": "SECRET=ghp_,opaque-second-secret", "must_not_contain": ["opaque-second-secret"], "must_contain": [], "expected": "SECRET=[REDACTED]"},
    {"name": "token-shaped prefix inside a sensitive value keeps the whole value (real token)", "input": ["SECRET=ghp_", "a1B2c3D4a1B2c3D4a1B2c3D4", ",opaque-second-secret done"], "must_not_contain": ["opaque-second-secret", "a1B2c3D4"], "must_contain": [], "expected": "SECRET=[REDACTED] done"},
    {"name": "sk- token then comma tail under a sensitive name", "input": ["TOKEN=sk-", "abcdefghijklmnopqrstuvwx", ",more,tail"], "must_not_contain": ["more", "tail"], "must_contain": [], "expected": "TOKEN=[REDACTED]"},
    {"name": "quoted comma value stays bounded by its quotes", "input": "password=\"a,b\",user=bob", "must_not_contain": ["a,b"], "must_contain": [], "expected": "password=[REDACTED],user=bob"},
    {"name": "AWS key id then second value under a sensitive name", "input": ["api_key=AKIA", "IOSFODNN7EXAMPLE", ",second"], "must_not_contain": ["second"], "must_contain": [], "expected": "api_key=[REDACTED]"},
    {"name": "token shape under a benign name is still masked", "input": ["note=sk-", "abcdefghijklmnopqrstuvwx", ",tail"], "must_not_contain": ["abcdefghij"], "must_contain": [], "expected": "note=[REDACTED],tail"}
  ]
