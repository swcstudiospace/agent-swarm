{
  "_doc": "Shared vectors for swarm/redact.py redact_text (tests/test_redact.py) and omp/src/swarm_bar.ts redactText (omp/test/swarm_bar.test.ts). A string or list of strings (joined with '') is used for input, must_not_contain and must_contain, so no secret-shaped literal sits in the repo. Output must contain no must_not_contain substring and every must_contain substring.",
  "cases": [
    {"name": "ghp token", "input": ["ran ", "ghp_", "a1B2c3D4a1B2c3D4a1B2c3D4a1B2", " ok"], "must_not_contain": [["ghp_", "a1B2c3D4"]], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "github_pat token", "input": ["ran ", "github_pat_", "11ABCDEFG011ABCDEFG011ABCDEFG0", " ok"], "must_not_contain": ["11ABCDEFG0"], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "sk token", "input": ["ran ", "sk-", "Zx9Qw8Er7Ty6Ui5O", " ok"], "must_not_contain": ["Zx9Qw8Er7Ty6Ui5O"], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "aws key id", "input": ["ran ", "AKIA", "ABCDEFGHIJ012345", " ok"], "must_not_contain": ["ABCDEFGHIJ012345"], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "slack token", "input": ["ran ", "xoxb-", "1234567890-abcdefghij", " ok"], "must_not_contain": ["1234567890-abcdefghij"], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "jwt", "input": ["ran ", "eyJhbGciOiJIUzI1NiJ9", ".", "eyJzdWIiOiIxMjM0NTY3ODkwIn0", ".", "dBjftJeZ4CVPmB92K27uhbUJU1p1r", " ok"], "must_not_contain": ["eyJzdWIiOiIx"], "must_contain": ["ran [REDACTED] ok"]},
    {"name": "bearer header keeps the scheme", "input": "Authorization: Bearer abcdefghij0123456789xyz", "must_not_contain": ["abcdefghij0123456789xyz"], "must_contain": ["Bearer [REDACTED]"]},
    {"name": "bearer with extra spaces", "input": "curl -H 'Authorization: Bearer   abcdefghij0123456789xyz' https://x.test", "must_not_contain": ["abcdefghij0123456789xyz"], "must_contain": ["[REDACTED]"]},
    {"name": "basic authorization header", "input": "curl -H 'Authorization: Basic dXNlcjpodW50ZXIyaHVudGVyMg==' https://x.test", "must_not_contain": ["dXNlcjpodW50ZXIy"], "must_contain": ["Authorization: Basic [REDACTED]"]},
    {"name": "proxy basic authorization header", "input": "Proxy-Authorization: Basic dXNlcjpodW50ZXIyaHVudGVyMg==", "must_not_contain": ["dXNlcjpodW50ZXIy"], "must_contain": ["Proxy-Authorization: Basic [REDACTED]"]},
    {"name": "basic header in quotes lower case", "input": "headers = {'authorization': 'basic dXNlcjpodW50ZXIyaHVudGVyMg=='}", "must_not_contain": ["dXNlcjpodW50ZXIy"], "must_contain": ["[REDACTED]"]},
    {"name": "pem block", "input": "key:\n-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA\nabc/def+ghi=\n-----END RSA PRIVATE KEY-----\ntail", "must_not_contain": ["MIIEowIBAAKCAQEA", "abc/def+ghi="], "must_contain": ["key:\n[REDACTED]\ntail"]},
    {"name": "truncated pem block", "input": "x -----BEGIN PRIVATE KEY-----\nMIIBVgIBADANBgkqhkiG9w0B", "must_not_contain": ["MIIBVgIBADANBgkqhkiG9w0B"], "must_contain": ["x [REDACTED]"]},
    {"name": "url userinfo", "input": "clone https://bob:pw123@example.com/repo.git now", "must_not_contain": ["pw123", "bob:"], "must_contain": ["https://[REDACTED]@example.com/repo.git now"]},
    {"name": "url userinfo with at sign in the password", "input": "psql postgres://u:p@ss-w0rd@db.internal/app", "must_not_contain": ["p@ss-w0rd", "ss-w0rd"], "must_contain": ["postgres://[REDACTED]@db.internal/app"]},
    {"name": "env assignment", "input": "API_KEY=hunter2hunter2 and PATH=/usr/bin", "must_not_contain": ["hunter2hunter2"], "must_contain": ["API_KEY=[REDACTED] and PATH=/usr/bin"]},
    {"name": "env assignment with quoted value", "input": "export DB_PASSWORD=\"two words here\" && run", "must_not_contain": ["two words here"], "must_contain": ["DB_PASSWORD=[REDACTED]"]},
    {"name": "single-quoted env assignment", "input": "GITHUB_TOKEN='abc123' x=1", "must_not_contain": ["abc123"], "must_contain": ["GITHUB_TOKEN=[REDACTED] x=1"]},
    {"name": "query string token", "input": "https://x.test/cb?token=abc123&page=2", "must_not_contain": ["abc123"], "must_contain": ["token=[REDACTED]&page=2"]},
    {"name": "flag with equals", "input": "run --password=s3cr3t --verbose", "must_not_contain": ["s3cr3t"], "must_contain": ["--password=[REDACTED] --verbose"]},
    {"name": "space-separated password flag", "input": "login --password hunter2", "must_not_contain": ["hunter2"], "must_contain": ["login --password [REDACTED]"]},
    {"name": "space-separated password flag mid-command", "input": "mysql --user root --password hunter2 --host db.internal", "must_not_contain": ["hunter2"], "must_contain": ["--user root", "--password [REDACTED] --host db.internal"]},
    {"name": "space-separated api-key flag", "input": "deploy --api-key sekrit123 --env prod", "must_not_contain": ["sekrit123"], "must_contain": ["--api-key [REDACTED] --env prod"]},
    {"name": "space-separated token flag with quoted value", "input": "gh --token \"tok with space\" run", "must_not_contain": ["tok with space"], "must_contain": ["--token [REDACTED]"]},
    {"name": "single-dash compound flag", "input": "tool -db-password hunter2 go", "must_not_contain": ["hunter2"], "must_contain": ["-db-password [REDACTED] go"]},
    {"name": "flag followed by another flag keeps both", "input": "run --password --verbose please", "must_not_contain": [], "must_contain": ["run --password --verbose please"]},
    {"name": "json pair", "input": "{\"api_key\": \"abc123\", \"name\": \"bob\", \"author\": \"ann\", \"tokens\": 12}", "must_not_contain": ["abc123"], "must_contain": ["\"api_key\": \"[REDACTED]\", \"name\": \"bob\", \"author\": \"ann\", \"tokens\": 12"]},
    {"name": "single-quoted python repr pair", "input": "{'password': 'hunter2', 'user': 'bob'}", "must_not_contain": ["hunter2"], "must_contain": ["'password': '[REDACTED]'", "'user': 'bob'"]},
    {"name": "mixed quote pair", "input": "{\"secret\": 'hunter2'}", "must_not_contain": ["hunter2"], "must_contain": ["[REDACTED]"]},
    {"name": "re-serialised json pair", "input": "{\\\"password\\\": \\\"hunter2\\\", \\\"k\\\": 1}", "must_not_contain": ["hunter2"], "must_contain": ["[REDACTED]"]},
    {"name": "task id untouched", "input": "run T7f3a-be.a2 finished", "must_not_contain": [], "must_contain": ["run T7f3a-be.a2 finished"]},
    {"name": "digest untouched", "input": ["artifact digest sha256:", "ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12", " ok"], "must_not_contain": [], "must_contain": ["artifact digest sha256:ab12", " ok"]},
    {"name": "prose about keys untouched", "input": "Plain prose: we rotated the keys, tokens and passwords last week.", "must_not_contain": [], "must_contain": ["Plain prose: we rotated the keys, tokens and passwords last week."]},
    {"name": "author untouched", "input": "Use the author field; author=bob authority is delegated", "must_not_contain": [], "must_contain": ["Use the author field; author=bob authority is delegated"]},
    {"name": "bare key and counts untouched", "input": "sort_key=z cache_key=k1 tokens=1200 max_tokens=64", "must_not_contain": [], "must_contain": ["sort_key=z cache_key=k1 tokens=1200 max_tokens=64"]},
    {"name": "short lookalikes untouched", "input": "sk-short ghp_short Bearer shortone the bearer of this message", "must_not_contain": [], "must_contain": ["sk-short ghp_short Bearer shortone the bearer of this message"]},
    {"name": "basic in prose untouched", "input": "a basic authorization scheme is described in the docs", "must_not_contain": [], "must_contain": ["a basic authorization scheme is described in the docs"]},
    {"name": "mail address and path untouched", "input": "mailto:bob@example.com https://example.com/a:b@c", "must_not_contain": [], "must_contain": ["mailto:bob@example.com https://example.com/a:b@c"]},
    {"name": "plain flags untouched", "input": "git commit --message fix --author bob", "must_not_contain": [], "must_contain": ["git commit --message fix --author bob"]}
  ]
}
